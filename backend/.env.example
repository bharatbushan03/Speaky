# Backend Environment Variables (FastAPI)
# Copy this file to .env for local development.
# For Azure Container Apps, set the same values with `azd env set` instead of this file.
# The container listens on PORT, which Azure sets to 8000.

# Application Settings
DEBUG=False
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
SUPABASE_URL=your_supabase_project_url
# Backend-only service role key for legacy/admin operations. Never send it to the browser.
SUPABASE_KEY=your_supabase_service_role_key
# Required for Supabase Auth validation and user-scoped PostgREST requests.
SUPABASE_ANON_KEY=your_supabase_anon_key

# AI Provider Configuration
# Options: groq, mock, openai, or azure_openai. Giani is intentionally unavailable until its
# official developer API is verified; do not invent or guess its endpoint.
AI_PROVIDER=groq
AI_REQUEST_TIMEOUT_SECONDS=60

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo

# Groq free-tier chat (if AI_PROVIDER=groq). Create a key at https://console.groq.com/keys
# qwen/qwen3.8-27b answers without a reasoning delay. openai/gpt-oss-20b is the slower fallback.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Azure OpenAI / Microsoft Foundry Configuration (if AI_PROVIDER=azure_openai)
# Use the Azure OpenAI resource endpoint or Microsoft Foundry project endpoint.
# The deployment value is the deployment name shown in Foundry.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=your_model_deployment_name

# Gnani speech. Shivani is the female Timbre v3 voice used for the interviewer.
# The key stays on the backend. Generate it in the Gnani API dashboard.
GIANI_API_KEY=your_gnani_api_key
GIANI_API_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Shivani

# Speech-to-Text Provider
# Options: gnani, openai, google, azure, mock
# gnani uses Prisma v3 at POST https://api.vachana.ai/stt/v3
STT_PROVIDER=gnani
GNANI_STT_MODEL=prisma-v3.0
# Options: gnani, openai, unconfigured, mock
TTS_PROVIDER=gnani

# Security Settings
SECRET_KEY=your_secret_key_change_this_in_production_min_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Settings (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Request protection. Add an edge/WAF limiter for multi-worker deployments.
MAX_REQUEST_BODY_BYTES=3000000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
