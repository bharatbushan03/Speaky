{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "secretKey": { "value": "${SECRET_KEY}" },
    "supabaseUrl": { "value": "${SUPABASE_URL}" },
    "supabaseAnonKey": { "value": "${SUPABASE_ANON_KEY}" },
    "aiProvider": { "value": "${AI_PROVIDER=mock}" },
    "openAiApiKey": { "value": "${OPENAI_API_KEY=}" },
    "openAiModel": { "value": "${OPENAI_MODEL=gpt-4o-mini}" },
    "groqApiKey": { "value": "${GROQ_API_KEY=}" },
    "groqModel": { "value": "${GROQ_MODEL=qwen/qwen3.8-27b}" },
    "azureOpenAiEndpoint": { "value": "${AZURE_OPENAI_ENDPOINT=}" },
    "azureOpenAiApiKey": { "value": "${AZURE_OPENAI_API_KEY=}" },
    "azureOpenAiDeployment": { "value": "${AZURE_OPENAI_DEPLOYMENT=}" },
    "gianiApiKey": { "value": "${GIANI_API_KEY=}" },
    "ttsProvider": { "value": "${TTS_PROVIDER=gnani}" },
    "sttProvider": { "value": "${STT_PROVIDER=gnani}" },
    "gnaniTtsModel": { "value": "${GNANI_TTS_MODEL=timbre-v3.0}" },
    "gnaniTtsVoice": { "value": "${GNANI_TTS_VOICE=Shivani}" },
    "gnaniSttModel": { "value": "${GNANI_STT_MODEL=prisma-v3.0}" }
  }
}
