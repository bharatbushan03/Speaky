# Browser-safe environment variables for the Next.js frontend.
# Copy this file to .env.local for local development, and set the same three
# variables in the Vercel project for Production and Preview.
# Never put provider keys, Supabase service-role keys, or backend signing secrets here.

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Enable Google and GitHub under Authentication > Providers.
# Redirect URLs: http://localhost:3000/auth/callback
# and https://<your-vercel-domain>/auth/callback
# plus the same paths with /auth/update-password.
