# Browser-safe environment variables for the Next.js frontend.
# Copy this file to .env.local for local development.
# Never put provider keys, Supabase service-role keys, or backend signing secrets here.
#
# Local names are the NEXT_PUBLIC_ variables below. On Azure Container Apps the
# same values are injected at runtime as API_URL, SUPABASE_URL, and
# SUPABASE_ANON_KEY, so the image does not have to be rebuilt when the API
# address changes.

# API Configuration. Locally this is the FastAPI origin. On Azure it is the API container URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Enable Google and GitHub under Authentication > Providers.
# Redirect URLs: http://localhost:3000/auth/callback
# and https://<your-azure-web-host>/auth/callback
# plus the same paths with /auth/update-password.
