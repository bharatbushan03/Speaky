# Server config for the Next.js frontend.
# The root layout reads these on the server and injects a small config object
# into the page. Do not use a NEXT_PUBLIC_ prefix.
# Never put provider keys, the Supabase service-role key, or backend signing secrets here.

# FastAPI origin. Locally this is http://localhost:8000.
API_URL=http://localhost:8000

# Supabase project URL and the publishable anon key.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Enable Google and GitHub under Authentication > Providers.
# Redirect URLs: http://localhost:3000/auth/callback
# and https://<your-azure-web-host>/auth/callback
# plus the same paths with /auth/update-password.
